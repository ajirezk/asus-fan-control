#!/usr/bin/env bash
# asusfan — ASUS laptop fan control.
# Author: ajirezk
#
# Default: opens the curses TUI window.
# CLI subcommands also available — see  asusfan --help
#
# Generated by install.sh: @APP_DIR@ is replaced with the install path.

set -euo pipefail

APP_DIR="@APP_DIR@"

if [ -t 1 ] && [ "${NO_COLOR:-}" = "" ]; then
    C_G=$'\033[32m'; C_C=$'\033[36m'; C_Y=$'\033[33m'
    C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'; C_RST=$'\033[0m'
else
    C_G=""; C_C=""; C_Y=""; C_BOLD=""; C_DIM=""; C_RST=""
fi

usage() {
    cat <<EOF
asusfan — ASUS Fan Control (by ajirezk)

Usage:
  ${C_C}asusfan${C_RST}                  open the TUI window (default)
  ${C_C}asusfan info${C_RST}             pretty status (no sudo)
  ${C_C}asusfan <0-100>${C_RST}          set both fans to N% (EC floor enforced)
  ${C_C}asusfan -f <0-100>${C_RST}       set N%, ${C_Y}BYPASS${C_RST} EC safety floor
  ${C_C}asusfan auto${C_RST}             restore factory automatic mode
  ${C_C}asusfan status${C_RST}           full JSON state (no sudo)
  ${C_C}asusfan apply --cpu N --gpu N${C_RST}    asymmetric per-fan control
  ${C_C}asusfan -h | --help${C_RST}      this help

${C_BOLD}Examples:${C_RST}
  ${C_C}asusfan${C_RST}                  → opens UI window
  ${C_C}asusfan info${C_RST}             → quick status, no sudo, no UI
  ${C_C}asusfan 50${C_RST}               → both fans 50% (will sudo automatically)
  ${C_C}asusfan -f 10${C_RST}            → really 10%, no floor (${C_Y}DANGEROUS${C_RST})
  ${C_C}asusfan auto${C_RST}             → firmware default

${C_BOLD}EC safety floor:${C_RST}
${C_DIM}When CPU/GPU is hot the tool raises your % to a safe minimum.${C_RST}
${C_DIM}If clamping happens, you'll see "raised by EC floor — use -f to bypass".${C_RST}
EOF
}

# Re-exec as root via sudo if not already, preserving args.
ensure_root() {
    if [ "${EUID:-$(id -u)}" -ne 0 ]; then
        exec sudo -E "$0" "$@"
    fi
}

# Pretty status (no root needed, just /sys reads).
show_info() {
    /usr/bin/env python3 - "$APP_DIR" <<'PY'
import json, os, subprocess, sys
app_dir = sys.argv[1]
if sys.stdout.isatty():
    G="\033[32m"; C="\033[36m"; Y="\033[33m"; D="\033[2m"; B="\033[1m"; R="\033[0m"
else:
    G=C=Y=D=B=R=""

p = subprocess.run([sys.executable, os.path.join(app_dir, "fan_hwmon.py"), "status"],
                   capture_output=True, text=True)
if p.returncode != 0:
    print(p.stderr, file=sys.stderr)
    sys.exit(p.returncode)
d = json.loads(p.stdout)
backend = d.get("backend", "curve")
mode    = d.get("mode", "?")
fans    = d.get("fans", {})
temps   = d.get("temperatures", {})

print(f"{B}ASUS Fan Control{R}")
print(f"  backend:  {C}{backend}{R}")
print(f"  mode:     {B}{mode}{R}")
for k in ("cpu", "gpu"):
    f = fans.get(k)
    if not f: continue
    pct = f.get("percent", 0)
    rpm = f.get("rpm", 0)
    label = f.get("label", k.upper())
    bar_filled = int(pct) // 5 if isinstance(pct, int) else 0
    bar = "█"*bar_filled + "░"*(20-bar_filled)
    print(f"  {label:<8} {C}{bar}{R} {B}{pct:>3}%{R}   {rpm} rpm")
for k in ("cpu", "gpu"):
    t = temps.get(k)
    if not t: continue
    print(f"  {k} temp: {Y}{t.get('celsius')}°C{R}  {D}({t.get('label')}){R}")
if backend != "curve":
    print(f"  {D}note: this backend has 3 quantized levels (not continuous %){R}")
PY
}

# ── dispatch ──────────────────────────────────────────────────────────────────
case "${1:-}" in

    -h|--help|help)
        usage
        exit 0
        ;;

    "")
        # Default: open the TUI window. Single sudo prompt for both daemon-start
        # AND tui.py (we re-exec the script as root so user enters password once).
        ensure_root
        # We are root now.
        if command -v systemctl >/dev/null 2>&1; then
            systemctl start asus-fan-control.service >/dev/null 2>&1 || true
        fi
        exec /usr/bin/env python3 "$APP_DIR/tui.py"
        ;;

    info)
        # Read-only; no sudo.
        show_info
        exit 0
        ;;

    status)
        # JSON, no sudo (just reads /sys).
        exec /usr/bin/env python3 "$APP_DIR/fan_hwmon.py" status
        ;;

    auto)
        ensure_root "$@"
        /usr/bin/env python3 "$APP_DIR/fan_hwmon.py" auto >/dev/null
        printf "%s✓%s restored factory %sautomatic%s mode\n" \
            "$C_G" "$C_RST" "$C_BOLD" "$C_RST"
        ;;

    -f|--force)
        shift
        pct="${1:-}"
        if ! [[ "$pct" =~ ^[0-9]+$ ]] || [ "$pct" -lt 0 ] || [ "$pct" -gt 100 ]; then
            printf "%sasusfan:%s -f needs a number 0-100 (got '%s')\n" \
                "$C_Y" "$C_RST" "$pct" >&2
            exit 1
        fi
        ensure_root --force "$pct"
        /usr/bin/env python3 "$APP_DIR/fan_hwmon.py" apply \
            --cpu "$pct" --gpu "$pct" --unsafe-no-floor >/dev/null
        printf "%s✓%s fans set to %s%s%%%s %s(EC floor bypassed)%s\n" \
            "$C_G" "$C_RST" "$C_BOLD" "$pct" "$C_RST" "$C_Y" "$C_RST"
        ;;

    apply)
        # advanced: asusfan apply --cpu N --gpu N [--unsafe-no-floor]
        ensure_root "$@"
        shift
        result=$(/usr/bin/env python3 "$APP_DIR/fan_hwmon.py" apply "$@")
        cpu_actual=$(printf '%s' "$result" | /usr/bin/env python3 -c \
            "import json,sys; print(json.load(sys.stdin)['fans']['cpu']['percent'])" 2>/dev/null || echo "?")
        gpu_actual=$(printf '%s' "$result" | /usr/bin/env python3 -c \
            "import json,sys; print(json.load(sys.stdin)['fans']['gpu']['percent'])" 2>/dev/null || echo "?")
        printf "%s✓%s applied — CPU %s%s%%%s, GPU %s%s%%%s\n" \
            "$C_G" "$C_RST" "$C_BOLD" "$cpu_actual" "$C_RST" "$C_BOLD" "$gpu_actual" "$C_RST"
        ;;

    [0-9]|[0-9][0-9]|100)
        pct="$1"
        ensure_root "$@"
        # Apply respects EC floor by default; check if we got clamped.
        result=$(/usr/bin/env python3 "$APP_DIR/fan_hwmon.py" \
            apply --cpu "$pct" --gpu "$pct")
        actual=$(printf '%s' "$result" | /usr/bin/env python3 -c \
            "import json,sys; print(json.load(sys.stdin)['fans']['cpu']['percent'])" \
            2>/dev/null || printf '%s' "$pct")
        if [ "$actual" != "$pct" ]; then
            printf "%s✓%s fans set to %s%s%%%s %s(requested %s%%, raised by EC floor — use %s-f%s to bypass)%s\n" \
                "$C_G" "$C_RST" "$C_BOLD" "$actual" "$C_RST" "$C_Y" "$pct" "$C_C" "$C_Y" "$C_RST"
        else
            printf "%s✓%s fans set to %s%s%%%s\n" \
                "$C_G" "$C_RST" "$C_BOLD" "$pct" "$C_RST"
        fi
        ;;

    *)
        printf "%sasusfan:%s unknown argument '%s'\n\n" "$C_Y" "$C_RST" "$1" >&2
        usage >&2
        exit 1
        ;;
esac
